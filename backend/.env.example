# PostgreSQL Database Connection URL (e.g. postgresql://postgres:password@localhost:5432/deadstock_db)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deadstock_db

# Security & JWT Token Signing
JWT_SECRET_KEY=change-this-to-a-very-secure-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
STORAGE_UPLOAD_DIR=storage/uploads

